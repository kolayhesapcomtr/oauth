# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oauth_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT (IMPORTANT: Change in production! Minimum 256 bits)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-256-bits-xxxxx
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-256
JWT_REFRESH_EXPIRES_IN=7d

# Payment Encryption (AES-256 - MUST be exactly 32 characters!)
PAYMENT_ENCRYPTION_KEY=change-this-32-character-key!

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:3002

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=OAuth Platform
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
